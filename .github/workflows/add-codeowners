name: Auto-add CODEOWNERS

on:
  push:
    branches: [main]
    # also trigger on pull request merges to main (handled by push event)

jobs:
  add-codeowners:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3
        with:
          fetch-depth: 0

      - name: Configure git user
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Create default CODEOWNERS if missing
        id: create_codeowners
        run: |
          if [ -f CODEOWNERS ] || [ -f .github/CODEOWNERS ]; then
            echo "CODEOWNERS already exists, nothing to do."
            exit 0
          fi

          echo "Creating default CODEOWNERS..."
          mkdir -p .github
          cat > .github/CODEOWNERS <<'EOF'
# CODEOWNERS — Auto-generated default
# Update this file to define reviewers for your codebase paths
# Docs: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# Example ownership — adjust teams/paths as needed
/scripts/ @your-org/team-backend
/tests/ @your-org/team-qa
/.github/ @your-org/team-devops

# Default fallback — optional: assign all unlisted files
# * @your-org/team-default
EOF
          git add .github/CODEOWNERS
          git commit -m "chore: add CODEOWNERS template [automation]"
          # Create a temporary branch for the PR
          git checkout -B automation/add-codeowners
          git push --set-upstream origin automation/add-codeowners --force-with-lease
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Open Pull Request for CODEOWNERS
        if: steps.create_codeowners.outcome == 'success' && steps.create_codeowners.conclusion == 'success'
        uses: peter-evans/create-pull-request@v6
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          title: "chore: add CODEOWNERS template"
          body: |
            ## 🤖 Auto-generated CODEOWNERS

            Default CODEOWNERS file created — no existing file found.

            ### Suggested next steps
            - Adjust paths/teams to match your org
            - Add repo‑wide defaults if needed
            - See: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

            *Generated by path‑scan automation*
          head: automation/add-codeowners
          base: main
          delete-branch: true

