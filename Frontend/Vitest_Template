5️⃣  src/test/utils.ts  — เครื่องมือช่วยทดสอบ
 
typescript  
/**
 * 🛠️ Test Helpers — ฟังก์ชันช่วยเขียนทดสอบ
 */
import { screen, waitFor } from '@testing-library/react'
import userEvent from '@testing-library/user-event'

// ค้นหาและตรวจสอบข้อความปรากฏ
export const expectText = async (text: string) => {
  await waitFor(() => {
    expect(screen.getByText(text)).toBeInTheDocument()
  })
}

// กดปุ่มตามข้อความ
export const clickButton = async (label: string) => {
  const btn = screen.getByRole('button', { name: new RegExp(label, 'i') })
  await userEvent.click(btn)
}

// พิมพ์ในช่องป้อนข้อมูล
export const typeInput = async (label: string, value: string) => {
  const input = screen.getByLabelText(new RegExp(label, 'i'))
  await userEvent.type(input, value)
}
 
 
 
 
6️⃣ ตัวอย่างทดสอบฟังก์ชัน  src/utils/format.test.ts 
 
typescript  
/**
 * 📋 Unit Test — ตัวอย่างฟังก์ชัน
 */
import { describe, test, expect } from 'vitest'
import { formatDate, formatNumber, truncate } from './format'

describe('📅 formatDate', () => {
  test('แปลงวันที่เป็นรูปแบบไทย', () => {
    expect(formatDate('2026-10-04')).toBe('04 ต.ค. 2026')
  })

  test('จัดการค่าว่าง', () => {
    expect(formatDate('')).toBe('-')
    expect(formatDate(null)).toBe('-')
    expect(formatDate(undefined)).toBe('-')
  })
})

describe('🔢 formatNumber', () => {
  test('ใส่จุลภาคตามหลักพัน', () => {
    expect(formatNumber(1234567)).toBe('1,234,567')
  })

  test('ทศนิยม 2 ตำแหน่ง', () => {
    expect(formatNumber(1234.56)).toBe('1,234.56')
  })
})

describe('✂️ truncate', () => {
  test่ตัดข้อความยาวเกิน', () => {
    expect(truncate('สวัสดีชาวโลก', 6)).toBe('สวัสดี...')
  })

  test('ไม่ตัดถ้าสั้นกว่าหรือเท่ากับ', () => {
    expect(truncate('สวัสดี', 5)).toBe('สวัสดี')
  })
})
 
 
 
 
7️⃣ ตัวอย่างทดสอบคอมโพเนนต์  src/components/SearchBar.test.tsx 
 
tsx  
/**
 * 🧩 Component Test — SearchBar
 */
import { describe, test, expect, vi } from 'vitest'
import { render, screen } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import SearchBar from './SearchBar'

describe('🔍 SearchBar', () => {
  const mockOnSearch = vi.fn()

  beforeEach(() => {
    mockOnSearch.mockClear()
  })

  test('แสดงช่องค้นหาและปุ่ม', () => {
    render(<SearchBar onSearch={mockOnSearch} />)
    
    expect(screen.getByPlaceholderText(/ค้นหา/i)).toBeInTheDocument()
    expect(screen.getByRole('button', { name: /ค้นหา/i })).toBeInTheDocument()
  })

  test('ปุ่มปิดตอนว่าง', () => {
    render(<SearchBar onSearch={mockOnSearch} disabled />)
    expect(screen.getByRole('button', { name: /ค้นหา/i })).toBeDisabled()
  })

  test('เรียก onSearch เมื่อกดส่ง', async () => {
    const user = userEvent.setup()
    render(<SearchBar onSearch={mockOnSearch} />)
    
    await user.type(screen.getByPlaceholderText(/ค้นหา/i), 'ZyntroAI')
    await user.click(screen.getByRole('button', { name: /ค้นหา/i }))
    
    expect(mockOnSearch).toHaveBeenCalledTimes(1)
    expect(mockOnSearch).toHaveBeenCalledWith('ZyntroAI')
  })

  test('เรียกเมื่อกด Enter', async () => {
    const user = userEvent.setup()
    render(<SearchBar onSearch={mockOnSearch} />)
    
    await user.type(screen.getByPlaceholderText(/ค้นหา/i), 'ทดสอบ{Enter}')
    
    expect(mockOnSearch).toHaveBeenCalledWith('ทดสอบ')
  })
})
 
 
 
 
