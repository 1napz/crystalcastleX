{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["system", "channels", "rules", "triggers"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["name", "version", "logLevel"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "logLevel": { "enum": ["debug", "info", "warn", "error", "silent"] },
        "historyRetentionDays": { "type": "number", "default": 90 }
      }
    },
    "channels": { "type": "object" },
    "rules": { "type": "object" },
    "triggers": { "type": "object" }
  }
}
